apiVersion: 1

groups:
  - orgId: 1
    name: raspberry-pi
    folder: Raspberry Pi
    interval: 1m
    rules:
      - uid: rpi-cpu-temperature
        title: CPU-Temperatur zu hoch
        condition: C
        for: 5m
        noDataState: NoData
        execErrState: Error
        annotations:
          summary: Der SoC liegt seit fünf Minuten über 70 °C. Kühler und Luftstrom prüfen.
        labels:
          severity: warning
        isPaused: false
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: prometheus
            model:
              refId: A
              editorMode: code
              instant: true
              expr: node_hwmon_temp_celsius{chip="thermal_thermal_zone0",sensor="temp0"}
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [70]

      - uid: rpi-disk-space
        title: Wurzeldateisystem läuft voll
        condition: C
        for: 10m
        noDataState: NoData
        execErrState: Error
        annotations:
          summary: Weniger als 15 Prozent frei auf dem Wurzeldateisystem. Retention senken oder die Daten auf eine SSD legen.
        labels:
          severity: warning
        isPaused: false
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: prometheus
            model:
              refId: A
              editorMode: code
              instant: true
              expr: 100 * node_filesystem_avail_bytes{mountpoint="/",fstype!="rootfs"} / node_filesystem_size_bytes{mountpoint="/",fstype!="rootfs"}
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: lt
                    params: [15]

      - uid: rpi-target-down
        title: Überwachtes Gerät offline
        condition: C
        for: 2m
        noDataState: Alerting
        execErrState: Error
        annotations:
          summary: Prometheus erreicht dieses Ziel seit zwei Minuten nicht mehr.
        labels:
          severity: critical
        isPaused: false
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: prometheus
            model:
              refId: A
              editorMode: code
              instant: true
              expr: up
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: lt
                    params: [1]

      - uid: rpi-under-voltage
        title: Unterspannung erkannt
        condition: C
        for: 1m
        noDataState: NoData
        execErrState: Error
        annotations:
          summary: Der Raspberry Pi meldet Unterspannung. Offizielles Netzteil verwenden und das Kabel prüfen.
        labels:
          severity: critical
        isPaused: false
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: prometheus
            model:
              refId: A
              editorMode: code
              instant: true
              expr: rpi_throttled_state{state="under_voltage"}
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [0]
